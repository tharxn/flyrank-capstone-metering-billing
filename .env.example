# All paths are relative to this project directory. Copy to .env; never commit .env.
DATABASE_PATH=data/billing.db
HOST=127.0.0.1
PORT=8000
WORKER_ENABLED=true
WORKER_POLL_SECONDS=1
JOB_MAX_ATTEMPTS=3
JOB_RETRY_SECONDS=2
# Leave blank for offline metering. Accepts sk_test_, rk_test_, and temporary rkcs_test_ keys only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# A test-mode recurring USD monthly Price, e.g. price_... ($20/month recommended).
STRIPE_PRO_PRICE_ID=
CHECKOUT_SUCCESS_URL=http://localhost:8000/billing/return?result=success
CHECKOUT_CANCEL_URL=http://localhost:8000/billing/return?result=cancelled
